includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - wpcomments.php
        - uninstall.php
        - includes
        - modules
        - templates
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    excludePaths:
        analyse:
            - build
            - tests
